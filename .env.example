# Copy to .env.local for local development. Read when the server starts.

# Where the Next.js server reaches the Go API. Never exposed to the browser.
API_INTERNAL_URL=http://127.0.0.1:8080

# The exact origin the browser uses for this app. The BFF rejects mutating requests from any other
# Origin, and the API's ALLOWED_ORIGINS must list this same value. Use localhost, not 127.0.0.1.
APP_ORIGIN=http://localhost:3000

# Reverse proxies between the internet and this server, whose X-Forwarded-For entries are believed.
# 0 uses the TCP peer as the client. Railway's edge counts as 1 (Phase 13).
TRUSTED_PROXY_HOPS=0

# Only read from the process environment, not from this file.
# PORT=3000
# HOST=0.0.0.0
